{"end": 523.337, "groups": [{"s": 1.283, "e": 7.98, "lines": [{"t": 1.333, "st": "n", "tx": "他生下来，小得能装进一只杯子。"}, {"t": 4.0, "st": "n", "tx": "没人以为他能{r:活下来}。"}, {"t": 6.0, "st": "n", "tx": "后来，他活了 {b:84 岁}，"}]}, {"s": 7.95, "e": 13.333, "lines": [{"t": 8.0, "st": "n", "tx": "还写下了{g:整个宇宙运转的规则}。"}, {"t": 10.667, "st": "n", "tx": "他叫{g:艾萨克 · 牛顿}。"}]}, {"s": 17.283, "e": 25.313, "lines": [{"t": 17.333, "st": "n", "tx": "{b:1642 年}圣诞节，英格兰林肯郡。"}, {"t": 20.0, "st": "n", "tx": "一座叫伍尔斯索普的石头农舍里，"}, {"t": 22.667, "st": "n", "tx": "他出生了。{r:父亲三个月前已经去世}。"}]}, {"s": 25.283, "e": 32.0, "lines": [{"t": 25.333, "st": "n", "tx": "他三岁那年，{r:母亲改嫁}，"}, {"t": 27.333, "st": "n", "tx": "搬去了继父家，"}, {"t": 29.333, "st": "n", "tx": "把他留给了{b:外祖母}。"}]}, {"s": 33.283, "e": 41.98, "lines": [{"t": 33.333, "st": "n", "tx": "十二岁，他去镇上读书，"}, {"t": 35.333, "st": "n", "tx": "寄住在一位{b:药剂师}家里。"}, {"t": 37.333, "st": "n", "tx": "他不爱跟同学玩，{g:爱做东西}："}, {"t": 40.0, "st": "n", "tx": "会转的风车，会走的水钟，"}]}, {"s": 41.95, "e": 52.667, "lines": [{"t": 42.0, "st": "n", "tx": "还在风筝上挂灯笼，夜里放上天。"}, {"t": 44.667, "st": "n", "tx": "十几岁时，母亲叫他回家种地。"}, {"t": 47.333, "st": "n", "tx": "他放羊的时候也在{b:看书}。"}, {"t": 49.333, "st": "n", "tx": "老师和舅舅劝母亲：让他去{g:读大学}吧。"}]}, {"s": 53.95, "e": 61.314, "lines": [{"t": 54.0, "st": "n", "tx": "{b:1661 年}，他进了{g:剑桥三一学院}。"}, {"t": 56.667, "st": "n", "tx": "身份是“{b:减费生}”："}, {"t": 58.667, "st": "n", "tx": "一边读书，一边给别人{r:干杂活抵学费}。"}]}, {"s": 61.284, "e": 70.001, "lines": [{"t": 61.334, "st": "n", "tx": "课堂上讲的，还是{r:两千年前}那一套。"}, {"t": 64.0, "st": "n", "tx": "他在自己的笔记本上，"}, {"t": 66.0, "st": "n", "tx": "抄起了新东西：{g:笛卡尔、伽利略、开普勒}……"}]}, {"s": 71.284, "e": 81.314, "lines": [{"t": 71.334, "st": "n", "tx": "{b:1663 年}，剑桥附近有个大集市。"}, {"t": 74.001, "st": "n", "tx": "他买了一本{b:占星书}，"}, {"t": 76.001, "st": "n", "tx": "书里有张星图，他看不懂：缺{b:三角学}。"}, {"t": 78.668, "st": "n", "tx": "于是他又买了一本{g:《几何原本》}。"}]}, {"s": 81.284, "e": 91.314, "lines": [{"t": 81.334, "st": "n", "tx": "翻了几条定理，他觉得{r:太简单}："}, {"t": 84.001, "st": "q", "tx": "{r:“这还用证明？”}随手丢在一边，"}, {"t": 86.668, "st": "n", "tx": "跳过去，直接啃更难的{b:新几何}。"}, {"t": 89.334, "st": "n", "tx": "第二年考奖学金，"}]}, {"s": 91.284, "e": 101.334, "lines": [{"t": 91.334, "st": "n", "tx": "考官{g:巴罗}考他欧几里得，他{r:答得很差}。"}, {"t": 94.001, "st": "n", "tx": "他回过头，把{g:《几何原本》}{g:一条一条重读}。"}, {"t": 97.335, "st": "n", "tx": "这一次，他{g:没再跳}。"}]}, {"s": 105.284, "e": 113.314, "lines": [{"t": 105.334, "st": "n", "tx": "{b:1665 年}，伦敦闹起了{r:大瘟疫}。"}, {"t": 108.001, "st": "n", "tx": "他刚拿到学士学位，{r:剑桥就关了门}。"}, {"t": 110.668, "st": "n", "tx": "他回到乡下老家，一待就是{b:将近两年}。"}]}, {"s": 113.284, "e": 121.334, "lines": [{"t": 113.334, "st": "n", "tx": "没有老师，没有同学，"}, {"t": 115.334, "st": "n", "tx": "只有一个{g:一直在想问题的人}。"}, {"t": 118.001, "st": "n", "tx": "后来，人们把这段日子叫做{g:“奇迹年”}。"}]}, {"s": 122.617, "e": 131.981, "lines": [{"t": 122.667, "st": "n", "tx": "第一个问题："}, {"t": 124.667, "st": "q", "tx": "{b:“这一瞬间”的速度}，到底怎么算？"}, {"t": 127.334, "st": "n", "tx": "一段路除以一段时间，只是{b:平均速度}。"}, {"t": 130.001, "st": "n", "tx": "把时间切得{b:越来越短}，"}]}, {"s": 131.951, "e": 139.334, "lines": [{"t": 132.001, "st": "n", "tx": "短到{b:几乎为零}，"}, {"t": 134.001, "st": "n", "tx": "就得到了{g:这一刻的速度}。"}, {"t": 136.001, "st": "n", "tx": "他叫它{g:“流数术”}，今天叫{g:微积分}。"}]}, {"s": 140.617, "e": 151.314, "lines": [{"t": 140.667, "st": "n", "tx": "第二个问题，从一棵{g:苹果树}开始。"}, {"t": 143.334, "st": "n", "tx": "很多年后，他对一位{b:老朋友}回忆："}, {"t": 146.001, "st": "n", "tx": "花园里，一只苹果落了下来。"}, {"t": 148.667, "st": "n", "tx": "他想：苹果为什么总是{b:垂直往下掉}？"}]}, {"s": 151.284, "e": 168.0, "lines": [{"t": 151.334, "st": "n", "tx": "不往旁边，也不往上，而是{g:朝着地心}。"}, {"t": 154.001, "st": "n", "tx": "砸到头？那是{r:后人加上去的}。"}, {"t": 156.667, "st": "n", "tx": "他接着想："}, {"t": 158.667, "st": "n", "tx": "这股力，能不能{g:一直伸到月亮}？"}]}, {"s": 171.951, "e": 182.648, "lines": [{"t": 172.001, "st": "n", "tx": "那时人们以为，白光是{b:最纯的光}，"}, {"t": 174.668, "st": "n", "tx": "三棱镜里出来的彩色，是{r:玻璃加上去的}。"}, {"t": 178.001, "st": "n", "tx": "他在窗板上开了一个{b:小孔}，"}, {"t": 180.668, "st": "n", "tx": "让一束阳光穿过三棱镜，"}]}, {"s": 182.618, "e": 189.981, "lines": [{"t": 182.668, "st": "n", "tx": "在墙上拉出一条长长的{g:彩带}。"}, {"t": 185.335, "st": "n", "tx": "他只挑出其中的{r:红光}，"}, {"t": 187.335, "st": "n", "tx": "再让它穿过{b:第二块三棱镜}——"}]}, {"s": 189.951, "e": 197.335, "lines": [{"t": 190.001, "st": "n", "tx": "{r:红光}还是红光，{g:不会再变}。"}, {"t": 192.001, "st": "n", "tx": "颜色{r:不是玻璃造的}，"}, {"t": 194.002, "st": "n", "tx": "白光，本来就是{g:所有颜色}混在一起。"}]}, {"s": 198.618, "e": 209.982, "lines": [{"t": 198.668, "st": "n", "tx": "透镜做的望远镜，看星星总带{r:彩边}，"}, {"t": 201.335, "st": "n", "tx": "因为不同颜色的光，{b:折的角度不一样}。"}, {"t": 204.002, "st": "n", "tx": "他干脆不用透镜，改用一面{g:凹面镜}。"}, {"t": 206.668, "st": "n", "tx": "{b:1668 年}，他亲手做出第一架{g:反射望远镜}。"}]}, {"s": 209.952, "e": 218.668, "lines": [{"t": 210.002, "st": "n", "tx": "只有{b:十几厘米}长，"}, {"t": 212.002, "st": "n", "tx": "{b:皇家学会}看了{g:很惊讶}，"}, {"t": 214.002, "st": "n", "tx": "{b:1672 年}，选他做了{g:会员}。"}]}, {"s": 222.618, "e": 229.982, "lines": [{"t": 222.668, "st": "n", "tx": "{b:1684 年}，天文学家{g:哈雷}来剑桥找他。"}, {"t": 226.002, "st": "n", "tx": "{g:哈雷}问：如果太阳的引力，"}, {"t": 228.002, "st": "n", "tx": "随{b:距离的平方}变弱，"}]}, {"s": 229.952, "e": 236.648, "lines": [{"t": 230.002, "st": "n", "tx": "行星会走出什么样的轨道？"}, {"t": 232.668, "st": "n", "tx": "他立刻回答：{g:椭圆}。"}, {"t": 234.668, "st": "n", "tx": "{g:哈雷}问：你怎么知道？"}]}, {"s": 236.618, "e": 244.002, "lines": [{"t": 236.668, "st": "q", "tx": "{g:“我算过。”}"}, {"t": 238.668, "st": "n", "tx": "可那份草稿，他一时{r:找不到了}。"}, {"t": 241.335, "st": "n", "tx": "他答应{b:重算一遍}，寄过去。"}]}, {"s": 245.285, "e": 253.315, "lines": [{"t": 245.335, "st": "n", "tx": "这一算，就{g:停不下来}了。"}, {"t": 247.335, "st": "n", "tx": "他几乎闭门不出，写了{b:一年半}。"}, {"t": 250.002, "st": "n", "tx": "{b:1687 年}，{g:《自然哲学的数学原理》}出版。"}]}, {"s": 253.285, "e": 259.335, "lines": [{"t": 253.335, "st": "n", "tx": "印书的钱，是{g:哈雷}帮忙出的。"}, {"t": 256.002, "st": "n", "tx": "书一开头，先立下{g:三条运动定律}。"}]}, {"s": 260.618, "e": 267.315, "lines": [{"t": 260.668, "st": "n", "tx": "{g:第一条}：没有力去推它，"}, {"t": 262.668, "st": "n", "tx": "静止的东西，就{b:一直静止}；"}, {"t": 264.668, "st": "n", "tx": "运动的东西，就{b:沿直线一直走下去}。"}]}, {"s": 267.285, "e": 273.335, "lines": [{"t": 267.335, "st": "n", "tx": "我们觉得东西会自己停下，"}, {"t": 270.002, "st": "n", "tx": "是因为地面和空气在{r:拦着它}。"}]}, {"s": 274.618, "e": 284.669, "lines": [{"t": 274.668, "st": "n", "tx": "{g:第二条}：同样的东西，推得越用力，"}, {"t": 277.335, "st": "n", "tx": "{b:速度变得越快}；"}, {"t": 279.335, "st": "n", "tx": "同样的力，东西越重，{b:越难推动}。"}, {"t": 282.002, "st": "n", "tx": "力，就是用来{g:改变运动}的。"}]}, {"s": 285.952, "e": 294.002, "lines": [{"t": 286.002, "st": "n", "tx": "{g:第三条}：你推别人一下，"}, {"t": 288.002, "st": "n", "tx": "别人也用{b:同样大的力}推你。"}, {"t": 290.669, "st": "n", "tx": "火箭把气往后喷，气就把火箭{g:往前推}。"}]}, {"s": 295.285, "e": 305.315, "lines": [{"t": 295.335, "st": "n", "tx": "然后，是书里{r:最大胆的一步}。"}, {"t": 298.002, "st": "n", "tx": "想象在高山顶上架一门{r:大炮}，"}, {"t": 300.669, "st": "n", "tx": "平着打出去，炮弹落在不远处。"}, {"t": 303.335, "st": "n", "tx": "打得更快，就{b:落得更远}。"}]}, {"s": 305.285, "e": 316.002, "lines": [{"t": 305.335, "st": "n", "tx": "快到一定程度，{b:地面往下弯}，"}, {"t": 308.002, "st": "n", "tx": "正好赶上炮弹往下掉——"}, {"t": 310.002, "st": "n", "tx": "它一直在掉，却{g:永远落不了地}。"}, {"t": 312.669, "st": "n", "tx": "月亮就是这样：它{g:一直在往地球掉}。"}]}, {"s": 317.285, "e": 328.649, "lines": [{"t": 317.335, "st": "n", "tx": "那么，月亮{r:掉得有多快}？"}, {"t": 319.335, "st": "n", "tx": "月亮离地心，大约是地球半径的 {b:60 倍}。"}, {"t": 322.669, "st": "n", "tx": "如果引力随{b:距离的平方}变弱，"}, {"t": 325.335, "st": "n", "tx": "那里的引力，只有地面的 {r:3600 分之一}。"}]}, {"s": 328.619, "e": 341.336, "lines": [{"t": 328.669, "st": "n", "tx": "地面上，苹果第一秒落下约 {b:4.9 米}；"}, {"t": 332.002, "st": "n", "tx": "月亮一秒钟，只往地球掉约 {b:1.4 毫米}。"}, {"t": 335.335, "st": "n", "tx": "拿月亮的真实轨道一算——{g:正好对上}。"}, {"t": 338.002, "st": "n", "tx": "苹果和月亮，被{g:同一种力}拉着。"}]}, {"s": 342.619, "e": 349.983, "lines": [{"t": 342.669, "st": "n", "tx": "而且不只是地球。"}, {"t": 344.669, "st": "n", "tx": "太阳拉着行星，行星拉着卫星，"}, {"t": 347.336, "st": "n", "tx": "{g:任何两个东西之间}，都有引力："}]}, {"s": 349.953, "e": 368.0, "lines": [{"t": 350.003, "st": "n", "tx": "{b:质量越大越强}，{b:距离越远越弱}。"}, {"t": 352.669, "st": "n", "tx": "天上和地上，第一次用{g:同一套规则}来算。"}, {"t": 356.003, "st": "n", "tx": "{b:彗星的路线}、{b:潮水的涨落}，都算得出来。"}]}, {"s": 371.55, "e": 380.78, "lines": [{"t": 371.6, "st": "n", "tx": "{b:1696 年}，他离开剑桥，"}, {"t": 373.6, "st": "n", "tx": "去伦敦当了{g:皇家铸币局的督办}。"}, {"t": 376.0, "st": "n", "tx": "那时英国的银币，"}, {"t": 378.0, "st": "n", "tx": "被人{r:剪边、熔掉、仿造}，{r:假币到处都是}。"}]}, {"s": 380.75, "e": 388.0, "lines": [{"t": 380.8, "st": "n", "tx": "他没把这当成{b:闲差}："}, {"t": 382.8, "st": "n", "tx": "他{r:安插线人}，{r:亲自审问}，"}, {"t": 384.8, "st": "n", "tx": "一年多里，做了{r:一百多次盘问}。"}]}, {"s": 388.75, "e": 397.98, "lines": [{"t": 388.8, "st": "n", "tx": "最狡猾的对手，叫{r:威廉 · 查洛纳}。"}, {"t": 391.2, "st": "n", "tx": "他造假币，还{r:反咬}铸币局的人{r:腐败}，"}, {"t": 394.0, "st": "n", "tx": "想让自己去管铸币局。"}, {"t": 396.0, "st": "n", "tx": "牛顿一个个找来{b:证人}。"}]}, {"s": 397.95, "e": 407.2, "lines": [{"t": 398.0, "st": "n", "tx": "{b:1699 年}，查洛纳被判{r:死刑}。"}, {"t": 400.4, "st": "n", "tx": "临刑前，他给牛顿写信："}, {"t": 402.4, "st": "q", "tx": "{r:“只有你能救我。”}"}, {"t": 404.4, "st": "n", "tx": "牛顿{r:没有回信}。"}]}, {"s": 407.95, "e": 417.18, "lines": [{"t": 408.0, "st": "n", "tx": "晚年，他还卷进一场{r:大争吵}。"}, {"t": 410.4, "st": "n", "tx": "德国的{g:莱布尼茨}，"}, {"t": 412.4, "st": "n", "tx": "{b:1684 年}先发表了{g:微积分}。"}, {"t": 414.8, "st": "n", "tx": "到底谁先发明？两边{r:吵了十几年}。"}]}, {"s": 417.15, "e": 432.0, "lines": [{"t": 417.2, "st": "n", "tx": "{b:皇家学会}出面调查，"}, {"t": 419.2, "st": "n", "tx": "可调查报告的结论，有一部分是{r:牛顿自己写的}。"}, {"t": 422.8, "st": "n", "tx": "今天的看法是：两人{g:各自独立发明}。"}, {"t": 425.6, "st": "n", "tx": "我们现在用的符号，大多来自{g:莱布尼茨}。"}]}, {"s": 435.953, "e": 446.67, "lines": [{"t": 436.003, "st": "n", "tx": "{b:1703 年}，他当上了{b:皇家学会}会长，"}, {"t": 439.337, "st": "n", "tx": "一直当到去世。"}, {"t": 441.337, "st": "n", "tx": "{b:1705 年}，女王封他为{g:爵士}。"}, {"t": 444.003, "st": "n", "tx": "他一生{b:没有结婚}。"}]}, {"s": 447.953, "e": 455.983, "lines": [{"t": 448.003, "st": "n", "tx": "{b:1727 年} 3 月，他在{b:睡梦中去世}，"}, {"t": 450.67, "st": "n", "tx": "{b:84 岁}。"}, {"t": 453.337, "st": "n", "tx": "他被葬进{g:威斯敏斯特教堂}，"}]}, {"s": 455.953, "e": 465.337, "lines": [{"t": 456.003, "st": "n", "tx": "当年考倒他的{g:巴罗}，{g:也葬在这里}。"}, {"t": 458.67, "st": "n", "tx": "一位法国作家看着这场葬礼，"}, {"t": 461.337, "st": "n", "tx": "后来写道：他们像{g:安葬一位国王}一样安葬他。"}]}, {"s": 466.62, "e": 480.004, "lines": [{"t": 466.67, "st": "n", "tx": "诗人{g:蒲柏}，为他写了两行墓志铭："}, {"t": 469.337, "st": "q", "tx": "“自然和自然的规律，{b:藏在黑夜里}。"}, {"t": 472.67, "st": "q", "tx": "上帝说：{g:让牛顿去吧！}"}, {"t": 475.337, "st": "q", "tx": "于是，{g:一切都亮了}。”"}]}, {"s": 481.287, "e": 491.317, "lines": [{"t": 481.337, "st": "n", "tx": "可据说，在去世前不久，"}, {"t": 483.337, "st": "n", "tx": "他是这样说自己的："}, {"t": 485.337, "st": "q", "tx": "“我不知道世人怎么看我。"}, {"t": 488.004, "st": "q", "tx": "我只觉得，自己像个在{g:海边玩耍的孩子}，"}]}, {"s": 491.287, "e": 506.671, "lines": [{"t": 491.337, "st": "q", "tx": "偶尔捡到一块{b:更光滑的石子}、"}, {"t": 494.004, "st": "q", "tx": "一只{b:更好看的贝壳}，就高兴起来；"}, {"t": 496.671, "st": "q", "tx": "而{g:真理的大海}，就在我面前，"}, {"t": 500.004, "st": "q", "tx": "全都{b:还没有被发现}。”"}]}, {"s": 507.288, "e": 519.337, "lines": [{"t": 507.338, "st": "n", "tx": "一个{g:早产的乡下孩子}；"}, {"t": 509.338, "st": "n", "tx": "一本被他嫌简单、又{g:回头重读}的书；"}, {"t": 512.004, "st": "n", "tx": "一束{g:拆开的阳光}，一个{g:一直在掉的月亮}；"}, {"t": 515.338, "st": "n", "tx": "他让天上和地上，第一次服从{g:同一套规则}。"}]}, {"s": 519.954, "e": 523.337, "lines": [{"t": 520.004, "st": "n", "tx": "内容整理自公开的史料和资料。"}]}], "chaps": [{"s": 13.333, "e": 16.0, "word": "乡下", "en": "THE VILLAGE", "line": "故事从一座石头农舍开始。", "n": "第一章"}, {"s": 101.334, "e": 104.001, "word": "瘟疫年", "en": "THE PLAGUE YEARS", "line": "1665 年，大学关门了。", "n": "第二章"}, {"s": 168.0, "e": 170.668, "word": "光", "en": "LIGHT", "line": "白光里，藏着什么？", "n": "第三章"}, {"s": 218.668, "e": 221.335, "word": "原理", "en": "PRINCIPIA", "line": "一次拜访，催生了一本书。", "n": "第四章"}, {"s": 368.0, "e": 370.8, "word": "另一面", "en": "THE OTHER SIDE", "line": "他不只是书斋里的人。", "n": "第五章"}, {"s": 432.0, "e": 434.67, "word": "晚年", "en": "THE LAST YEARS", "line": "他活得很久。", "n": "第六章"}], "crumbs": [{"t": 0.6, "zh": "人物传记 · 牛顿", "en": "BIOGRAPHY  ISAAC NEWTON 1642–1727"}, {"t": 13.333, "zh": "第一章 · 乡下", "en": "CH.1  THE VILLAGE"}, {"t": 101.334, "zh": "第二章 · 瘟疫年", "en": "CH.2  THE PLAGUE YEARS"}, {"t": 168.0, "zh": "第三章 · 光", "en": "CH.3  LIGHT"}, {"t": 218.668, "zh": "第四章 · 原理", "en": "CH.4  PRINCIPIA"}, {"t": 368.0, "zh": "第五章 · 另一面", "en": "CH.5  THE OTHER SIDE"}, {"t": 432.0, "zh": "第六章 · 晚年", "en": "CH.6  THE LAST YEARS"}, {"t": 506.671, "zh": "回顾", "en": "RECAP"}], "counters": [{"label": "引力只剩地面的", "a": 1, "b": 3600, "unit": "分之一", "t0": 325.635, "t1": 327.935, "hide": 335.235, "col": null, "land": "#ef5b43", "pw": 2.2, "endtxt": null}], "slams": [{"tx": "牛顿", "t": 10.817, "x": 560, "y": 690, "size": 200, "col": "#f2d39a", "e": 13.233, "en": "ISAAC NEWTON · 1642–1727"}, {"tx": "考砸了", "t": 92.534, "x": 1500, "y": 380, "size": 120, "col": "#ef5b43", "e": 93.701, "en": null}, {"tx": "对上了", "t": 336.935, "x": 1580, "y": 230, "size": 120, "col": "#f0bd5c", "e": 339.502, "en": null}, {"tx": "死刑", "t": 398.2, "x": 1500, "y": 360, "size": 150, "col": "#ef5b43", "e": 400.6, "en": null}], "shake": [[7.6, 8], [10.817, 16], [13.683, 14], [85.151, 5], [92.534, 12], [101.684, 14], [147.051, 4], [168.35, 14], [190.001, 8], [214.202, 5], [219.018, 14], [232.968, 6], [236.668, 14], [250.202, 16], [260.668, 12], [274.668, 12], [286.002, 12], [300.869, 8], [303.435, 9], [304.235, 10], [310.002, 6], [312.869, 10], [327.935, 10], [336.935, 10], [352.669, 14], [368.35, 14], [384.8, 3.0], [385.22, 3.15], [385.556, 3.3], [385.825, 3.45], [386.04, 3.6], [386.212, 3.75], [386.349, 3.9], [386.469, 4.05], [386.589, 4.2], [386.709, 4.35], [386.829, 4.5], [386.949, 4.65], [387.0, 14], [398.2, 18], [405.0, 4], [420.6, 12], [432.35, 14], [441.937, 5]], "sfx": [["count_tick", 6.1, 0.28, 0.2], ["count_tick", 6.3, 0.28, 0.2], ["count_tick", 6.5, 0.28, 0.2], ["count_tick", 6.7, 0.28, 0.2], ["count_tick", 6.9, 0.28, 0.2], ["count_tick", 7.1, 0.28, 0.2], ["count_tick", 7.3, 0.28, 0.2], ["count_tick", 7.5, 0.28, 0.2], ["hit_drum2", 7.6, 0.75, 0.0], ["slam", 7.6, 0.3375, 0.0], ["hit_dr