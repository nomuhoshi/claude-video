{
"groups": [
{
"s": 0.0,
"e": 6.4,
"lines": [
{
"t": 0.4,
"st": "n",
"tx": "1601 年，{g:第谷}去世。"
},
{
"t": 2.0,
"st": "n",
"tx": "他二十多年的火星记录，"
},
{
"t": 3.6,
"st": "n",
"tx": "落到了{b:开普勒}手里。"
}
]
},
{
"s": 6.4,
"e": 14.4,
"lines": [
{
"t": 6.4,
"st": "n",
"tx": "开普勒先用{b:正圆}去套："
},
{
"t": 8.8,
"st": "n",
"tx": "圆心挪一挪，速度调一调，"
},
{
"t": 11.2,
"st": "n",
"tx": "算一遍，不对，{r:再算一遍}。"
}
]
},
{
"s": 14.4,
"e": 19.2,
"lines": [
{
"t": 14.4,
"st": "n",
"tx": "他在书里写："
},
{
"t": 15.2,
"st": "q",
"tx": "“你若嫌这算法冗长，"
},
{
"t": 16.4,
"st": "q",
"tx": "就可怜可怜我吧："
},
{
"t": 17.6,
"st": "q",
"tx": "我至少算了{r:七十遍}。”"
}
]
},
{
"s": 19.2,
"e": 24.0,
"lines": [
{
"t": 19.2,
"st": "n",
"tx": "大部分观测，都对上了。"
},
{
"t": 22.4,
"st": "n",
"tx": "可有几处，偏了——"
}
]
},
{
"s": 24.0,
"e": 36.8,
"lines": [
{
"t": 24.0,
"st": "big",
"tx": "{r:八角分}。"
},
{
"t": 27.2,
"st": "n",
"tx": "第谷的误差，只有{b:两角分}左右。"
},
{
"t": 30.4,
"st": "n",
"tx": "八角分，是它的{r:四倍}。"
},
{
"t": 33.6,
"st": "n",
"tx": "这{r:不可能}是看错了。"
}
]
},
{
"s": 36.8,
"e": 48.0,
"lines": [
{
"t": 36.8,
"st": "n",
"tx": "他写道："
},
{
"t": 38.4,
"st": "q",
"tx": "“单单这{r:八角分}，"
},
{
"t": 40.8,
"st": "q",
"tx": "就将带领我们{b:改革整个天文学}。”"
}
]
},
{
"s": 48.0,
"e": 52.8,
"lines": [
{
"t": 48.0,
"st": "n",
"tx": "他放弃了{b:正圆}。"
},
{
"t": 50.4,
"st": "n",
"tx": "1605 年，他终于想通了："
}
]
},
{
"s": 52.8,
"e": 60.8,
"lines": [
{
"t": 52.8,
"st": "n",
"tx": "火星走的，是一个{g:椭圆}。"
},
{
"t": 56.0,
"st": "n",
"tx": "太阳不在正中，"
},
{
"t": 57.6,
"st": "n",
"tx": "而在它的一个{g:焦点}上。"
}
]
}
],
