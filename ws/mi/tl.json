{"end": 402.336, "groups": [{"s": 2.617, "e": 11.98, "lines": [{"t": 2.667, "st": "n", "tx": "1887 年，美国克利夫兰。"}, {"t": 5.333, "st": "n", "tx": "一间地下室里，"}, {"t": 7.333, "st": "n", "tx": "一块大石板，漂在一池{b:水银}上，"}, {"t": 10.0, "st": "n", "tx": "慢慢地转。"}]}, {"s": 11.95, "e": 21.313, "lines": [{"t": 12.0, "st": "n", "tx": "两个人轮流趴在目镜前，"}, {"t": 14.667, "st": "n", "tx": "看一组明暗相间的{g:条纹}。"}, {"t": 17.333, "st": "n", "tx": "他们在等条纹{b:移动}。"}, {"t": 19.333, "st": "n", "tx": "条纹，{r:一动不动}。"}]}, {"s": 21.283, "e": 28.667, "lines": [{"t": 21.333, "st": "n", "tx": "他叫{g:迈克尔逊}。"}, {"t": 23.334, "st": "n", "tx": "他最有名的实验，"}, {"t": 25.334, "st": "big", "tx": "{r:什么也没找到}"}]}, {"s": 32.617, "e": 43.314, "lines": [{"t": 32.667, "st": "n", "tx": "1852 年，迈克尔逊出生在普鲁士，"}, {"t": 36.001, "st": "n", "tx": "今天属于{b:波兰}。"}, {"t": 38.001, "st": "n", "tx": "两岁时，全家移民{b:美国}，"}, {"t": 40.667, "st": "n", "tx": "落脚在{g:加州}淘金热的矿镇，"}]}, {"s": 43.284, "e": 50.667, "lines": [{"t": 43.334, "st": "n", "tx": "后来又搬到{g:内华达}的银矿镇。"}, {"t": 46.001, "st": "n", "tx": "父亲开一间杂货店。"}, {"t": 48.001, "st": "n", "tx": "他在矿镇上长大。"}]}, {"s": 51.95, "e": 61.314, "lines": [{"t": 52.0, "st": "n", "tx": "十六岁，他想考{b:海军学院}。"}, {"t": 54.667, "st": "n", "tx": "他考得很好，名额却给了别人。"}, {"t": 57.334, "st": "n", "tx": "据他后来的回忆，"}, {"t": 59.334, "st": "n", "tx": "他一个人去了{b:华盛顿}，"}]}, {"s": 61.284, "e": 72.001, "lines": [{"t": 61.334, "st": "n", "tx": "想当面见{g:格兰特总统}。"}, {"t": 63.334, "st": "n", "tx": "最后，他进了海军学院。"}, {"t": 66.0, "st": "n", "tx": "毕业后，他在海上服役了两年，"}, {"t": 68.667, "st": "n", "tx": "1875 年回到母校，教{g:物理}。"}]}, {"s": 77.95, "e": 86.38, "lines": [{"t": 78.0, "st": "n", "tx": "教学生的时候，"}, {"t": 80.0, "st": "n", "tx": "他想把{g:光速}量得更准。"}, {"t": 82.0, "st": "n", "tx": "光太快了："}, {"t": 84.0, "st": "n", "tx": "一秒钟，绕地球{g:七圈半}。"}]}, {"s": 86.35, "e": 95.58, "lines": [{"t": 86.4, "st": "n", "tx": "他用的是{b:转镜法}："}, {"t": 88.4, "st": "n", "tx": "光打到一面{b:转动}的镜子上，"}, {"t": 90.8, "st": "n", "tx": "跑去远处的镜子，再跑回来。"}, {"t": 93.6, "st": "n", "tx": "就在这一来一回之间，"}]}, {"s": 95.55, "e": 103.18, "lines": [{"t": 95.6, "st": "n", "tx": "转镜已经转过了{b:一个小角度}，"}, {"t": 98.4, "st": "n", "tx": "光点，偏了一点点。"}, {"t": 100.4, "st": "n", "tx": "量出这一点，就能算出光速。"}]}, {"s": 103.15, "e": 111.58, "lines": [{"t": 103.2, "st": "n", "tx": "1878 年，他自己花了{g:十美元}，"}, {"t": 106.0, "st": "n", "tx": "买了一面转镜，先试了一次。"}, {"t": 108.8, "st": "n", "tx": "后来拿到两千美元，把装置做大。"}]}, {"s": 111.55, "e": 118.8, "lines": [{"t": 111.6, "st": "n", "tx": "1879 年的结果："}, {"t": 113.6, "st": "n", "tx": "每秒{g:约 29 万 9 千 9 百}公里。"}, {"t": 116.4, "st": "n", "tx": "他才二十六岁。"}]}, {"s": 120.35, "e": 129.18, "lines": [{"t": 120.4, "st": "n", "tx": "光是一种{b:波}。"}, {"t": 122.4, "st": "n", "tx": "水波在水里传，声波在空气里传，"}, {"t": 125.2, "st": "n", "tx": "那光呢？"}, {"t": 127.2, "st": "n", "tx": "那时的物理学家相信："}]}, {"s": 129.15, "e": 139.58, "lines": [{"t": 129.2, "st": "n", "tx": "整个宇宙，充满了一种看不见的东西，"}, {"t": 132.4, "st": "n", "tx": "叫{g:以太}。"}, {"t": 134.4, "st": "n", "tx": "地球绕着太阳飞，每秒{b:30 公里}，"}, {"t": 137.2, "st": "n", "tx": "那就该一直{r:迎着以太风}。"}]}, {"s": 139.55, "e": 148.8, "lines": [{"t": 139.6, "st": "n", "tx": "迎着风跑的光，和侧着跑的光，"}, {"t": 142.4, "st": "n", "tx": "速度应该差一点点。"}, {"t": 144.4, "st": "n", "tx": "差多少？"}, {"t": 146.4, "st": "n", "tx": "大约{g:一亿分之一}。"}]}, {"s": 153.15, "e": 163.18, "lines": [{"t": 153.2, "st": "n", "tx": "一亿分之一，任何钟都量不出来。"}, {"t": 156.0, "st": "n", "tx": "迈克尔逊换了个办法："}, {"t": 158.0, "st": "n", "tx": "不量速度，{b:比较}两束光。"}, {"t": 160.4, "st": "n", "tx": "一束光，用半透镜{g:分成两半}："}]}, {"s": 163.15, "e": 170.38, "lines": [{"t": 163.2, "st": "n", "tx": "一半往前，一半往侧面，"}, {"t": 165.6, "st": "n", "tx": "各跑一段，被镜子反射回来，"}, {"t": 168.4, "st": "n", "tx": "再{g:合在一起}。"}]}, {"s": 170.35, "e": 176.78, "lines": [{"t": 170.4, "st": "n", "tx": "波峰对波峰，就{g:亮}；"}, {"t": 172.4, "st": "n", "tx": "错开半个波长，就{b:暗}。"}, {"t": 174.4, "st": "n", "tx": "合起来，是一组明暗条纹。"}]}, {"s": 176.75, "e": 184.0, "lines": [{"t": 176.8, "st": "n", "tx": "哪条路上的光慢了一点点，"}, {"t": 179.2, "st": "n", "tx": "条纹就会{g:移动}。"}, {"t": 181.2, "st": "n", "tx": "这就是{g:迈克尔逊干涉仪}。"}]}, {"s": 185.55, "e": 193.98, "lines": [{"t": 185.6, "st": "n", "tx": "1881 年，他在欧洲留学，"}, {"t": 188.0, "st": "n", "tx": "第一次做了这个实验。"}, {"t": 190.0, "st": "n", "tx": "柏林街上一有震动，"}, {"t": 192.0, "st": "n", "tx": "条纹就乱晃。"}]}, {"s": 193.95, "e": 202.0, "lines": [{"t": 194.0, "st": "n", "tx": "他把仪器搬到了{b:波茨坦}天文台。"}, {"t": 196.8, "st": "n", "tx": "结果：看不到预期的移动。"}, {"t": 199.2, "st": "n", "tx": "可仪器太小，结论{r:不够硬}。"}]}, {"s": 203.55, "e": 213.98, "lines": [{"t": 203.6, "st": "n", "tx": "1887 年，他和化学家{g:莫雷}，"}, {"t": 206.0, "st": "n", "tx": "在克利夫兰造了一台大得多的仪器。"}, {"t": 209.2, "st": "n", "tx": "光在石板上来回反射好几次，"}, {"t": 212.0, "st": "n", "tx": "总路程拉长到{g:十一米}。"}]}, {"s": 213.95, "e": 221.18, "lines": [{"t": 214.0, "st": "n", "tx": "一块一米半见方的砂岩石板，"}, {"t": 216.8, "st": "n", "tx": "漂在一池{b:水银}上，"}, {"t": 218.8, "st": "n", "tx": "转起来，几乎没有摩擦。"}]}, {"s": 221.15, "e": 228.38, "lines": [{"t": 221.2, "st": "n", "tx": "他们一边转，一边看条纹，"}, {"t": 223.6, "st": "n", "tx": "一连看了几天。"}, {"t": 225.6, "st": "n", "tx": "按理，条纹该移动{g:零点四条}。"}]}, {"s": 228.35, "e": 235.6, "lines": [{"t": 228.4, "st": "n", "tx": "实际看到的，"}, {"t": 230.4, "st": "n", "tx": "{r:不到预期的二十分之一}。"}, {"t": 232.8, "st": "n", "tx": "以太风，好像{r:根本不存在}。"}]}, {"s": 241.285, "e": 251.982, "lines": [{"t": 241.335, "st": "n", "tx": "迈克尔逊自己，"}, {"t": 243.335, "st": "n", "tx": "一直没有真正接受这个结果。"}, {"t": 246.002, "st": "n", "tx": "欧洲的物理学家，想办法{b:救以太}。"}, {"t": 249.335, "st": "n", "tx": "一个爱尔兰人，一个荷兰人，"}]}, {"s": 251.952, "e": 259.315, "lines": [{"t": 252.002, "st": "n", "tx": "先后提出：运动的物体，"}, {"t": 254.669, "st": "n", "tx": "也许会沿运动方向{g:缩短}一点点，"}, {"t": 257.335, "st": "n", "tx": "正好把差别抵消。"}]}, {"s": 259.285, "e": 266.649, "lines": [{"t": 259.335, "st": "n", "tx": "荷兰人叫{g:洛伦兹}。"}, {"t": 261.335, "st": "n", "tx": "十八年后，一个二十六岁的专利局职员说："}, {"t": 264.669, "st": "n", "tx": "根本不需要以太。"}]}, {"s": 266.619, "e": 276.002, "lines": [{"t": 266.669, "st": "n", "tx": "光速，对谁来说都{g:一样}。"}, {"t": 269.336, "st": "n", "tx": "他叫{g:爱因斯坦}。"}, {"t": 271.336, "st": "n", "tx": "那个“零”，成了相对论最有名的{g:旁证}。"}]}, {"s": 277.285, "e": 288.649, "lines": [{"t": 277.335, "st": "n", "tx": "1907 年，迈克尔逊获得{g:诺贝尔物理学奖}，"}, {"t": 280.669, "st": "n", "tx": "奖给他的{b:精密光学仪器}，"}, {"t": 283.335, "st": "n", "tx": "和用它们做的测量。"}, {"t": 285.335, "st": "n", "tx": "他是第一个获得诺贝尔科学奖的{g:美国人}。"}]}, {"s": 288.619, "e": 298.649, "lines": [{"t": 288.669, "st": "n", "tx": "早些年，他在一次演讲里，"}, {"t": 291.335, "st": "n", "tx": "引用过一句话："}, {"t": 293.335, "st": "n", "tx": "物理学的大定律，差不多都发现了，"}, {"t": 296.669, "st": "n", "tx": "以后的新东西，"}]}, {"s": 298.619, "e": 308.669, "lines": [{"t": 298.669, "st": "n", "tx": "要到小数点后第{r:六位}里去找。"}, {"t": 301.336, "st": "n", "tx": "几年后，量子和相对论来了。"}, {"t": 304.002, "st": "n", "tx": "线索，就藏在他自己测出的那个{g:零}里。"}]}, {"s": 313.285, "e": 323.982, "lines": [{"t": 313.335, "st": "n", "tx": "1920 年代，他又回到了老本行。"}, {"t": 316.002, "st": "n", "tx": "在加州{b:威尔逊山}上放一面转镜，"}, {"t": 318.669, "st": "n", "tx": "光射向{g:三十五公里}外的另一座山，"}, {"t": 322.002, "st": "n", "tx": "再反射回来。"}]}, {"s": 323.952, "e": 334.003, "lines": [{"t": 324.002, "st": "n", "tx": "一来一回，{g:七十公里}。"}, {"t": 326.002, "st": "n", "tx": "1926 年，结果："}, {"t": 328.002, "st": "n", "tx": "每秒{g:29 万 9 千 7 百 96}公里。"}, {"t": 330.669, "st": "n", "tx": "和今天的数，只差{g:几公里}。"}]}, {"s": 335.286, "e": 344.65, "lines": [{"t": 335.336, "st": "n", "tx": "空气会让光{r:慢一点}。"}, {"t": 337.336, "st": "n", "tx": "他想在真空里量。"}, {"t": 339.336, "st": "n", "tx": "1929 年，他在加州的农场，"}, {"t": 342.003, "st": "n", "tx": "架起一条{g:一英里长}的真空管。"}]}, {"s": 344.62, "e": 353.316, "lines": [{"t": 344.67, "st": "n", "tx": "光在管里来回反射，"}, {"t": 346.67, "st": "n", "tx": "路程拉长到{b:五英里}。"}, {"t": 348.67, "st": "n", "tx": "1931 年 5 月 9 日，"}, {"t": 350.67, "st": "n", "tx": "迈克尔逊去世，终年七十八岁。"}]}, {"s": 353.286, "e": 362.669, "lines": [{"t": 353.336, "st": "n", "tx": "{r:实验还没做完}。"}, {"t": 355.336, "st": "n", "tx": "四年后，同事发表了结果："}, {"t": 358.003, "st": "n", "tx": "每秒 29 万 9 千 7 百 74 公里。"}]}, {"s": 363.952, "e": 373.982, "lines": [{"t": 364.002, "st": "n", "tx": "1983 年，人们不再“测量”光速。"}, {"t": 367.336, "st": "n", "tx": "国际计量大会直接规定："}, {"t": 370.002, "st": "n", "tx": "光速，就是每秒"}, {"t": 372.002, "st": "n", "tx": "{g:299,792,458} 米。"}]}, {"s": 373.952, "e": 384.003, "lines": [{"t": 374.002, "st": "n", "tx": "反过来，一米的长度，"}, {"t": 376.002, "st": "n", "tx": "由光速来定义。"}, {"t": 378.002, "st": "n", "tx": "他用一辈子量的那个数，"}, {"t": 380.669, "st": "n", "tx": "成了{g:尺子}本身。"}]}], "chaps": [{"s": 28.667, "e": 31.334, "word": "少年", "en": "", "line": "一个在矿镇长大的移民孩子。", "n": ""}, {"s": 73.6, "e": 76.4, "word": "光速", "en": "", "line": "十块钱的镜子。", "n": ""}, {"s": 148.8, "e": 151.6, "word": "干涉仪", "en": "", "line": "量出一亿分之一。", "n": ""}, {"s": 237.335, "e": 240.002, "word": "零", "en": "", "line": "他最有名的实验，什么也没找到。", "n": ""}, {"s": 309.336, "e": 312.002, "word": "最后", "en": "", "line": "七十多岁，他还在量光速。", "n": ""}], "crumbs": [{"t": 22.133, "zh": "人物传记 · 迈克尔逊", "en": ""}, {"t": 28.667, "zh": "少年", "en": ""}, {"t": 73.6, "zh": "光速", "en": ""}, {"t": 148.8, "zh": "干涉仪", "en": ""}, {"t": 237.335, "zh": "零", "en": ""}, {"t": 309.336, "zh": "最后", "en": ""}, {"t": 384.003, "zh": "回顾", "en": ""}, {"t": 395.336, "zh": "资料来源", "en": ""}], "counters": [{"label": "1879 年的结果", "a": 0, "b": 299900, "unit": "公里/秒", "t0": 113.7, "t1": 115.1, "hide": 118.5, "col": null, "land": "#f0bd5c", "pw": 1.8, "dec": 0, "endtxt": null}, {"label": "1926 年", "a": 0, "b": 299796, "unit": "公里/秒", "t0": 328.102, "t1": 329.502, "hide": 333.703, "col": null, "land": "#f0bd5c", "pw": 1.8, "dec": 0, "endtxt": null}], "slams": [], "shake": [[19.833, 8], [21.733, 8], [25.834, 14], [29.017, 12], [55.267, 4], [63.834, 8], [73.95, 12], [103.8, 6], [115.1, 10], [132.8, 8], [137.7, 6], [147.0, 12], [149.15, 12], [181.7, 10], [199.6, 6], [212.5, 4], [230.9, 10], [237.685, 12], [259.735, 6], [269.736, 10], [285.835, 8], [299.169, 8], [304.502, 10], [309.686, 12], [329.502, 10], [353.836, 6], [372.502, 14], [381.169, 10], [391.636, 10]], "sfx": [["sub_pad", 0, 0.35, 0.0], ["ui_ping_1", 12.4, 0.35, 0.0], ["ui_ping_2", 15.067, 0.35, 0.0], ["whoosh_swing", 17.633, 